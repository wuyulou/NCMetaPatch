{
  "manifest_version": 3,
  "name": "NCMetaPatch",
  "version": "0.2.1",
  "description": "一个用于整理专辑资料并辅助填写网易云音乐专辑补充页的 Chrome/Edge MV3 扩展。在 Discogs、Rate Your Music 或 Bandcamp 的专辑页面点击左下角按钮，扩展会采集当前专辑资料、下载封面、打开网易云补充页，并尝试自动填写可识别字段。封面选择、内容复核和最终提交始终由你手动完成。",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel", "scripting", "downloads"],
  "host_permissions": [
    "https://api.discogs.com/*",
    "https://www.discogs.com/*",
    "https://rateyourmusic.com/*",
    "https://*.bandcamp.com/*",
    "https://music.163.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "NCMetaPatch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/icon-32.png"],
      "matches": [
        "https://www.discogs.com/*",
        "https://rateyourmusic.com/*",
        "https://*.bandcamp.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://music.163.com/*"],
      "js": ["src/shared.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.discogs.com/*",
        "https://rateyourmusic.com/*",
        "https://*.bandcamp.com/*"
      ],
      "js": ["src/shared.js", "src/source-content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
